# Copy to .env and edit. Only read when the container starts.
# Port on this host for the web UI and agents (put HTTPS in front of it).
DYNALLOW_HTTP_PORT=8080
# First start only: admin username, and password (12+ chars). Leave the password
# empty to have one generated and printed once in `docker compose logs`.
DYNALLOW_ADMIN=admin
DYNALLOW_PASSWORD=
# Reverse proxy in front (HAProxy, nginx, Caddy): its IP or CIDR, comma-separated.
# Without this every site looks like it comes from the proxy and its IP is held.
DYNALLOW_TRUSTED_PROXIES=
# Set to 1 once users reach the web UI over HTTPS.
DYNALLOW_SECURE_COOKIES=0
TZ=America/Chicago
